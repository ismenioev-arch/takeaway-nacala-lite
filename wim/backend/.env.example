##############################################################################
# WIM — WhatsApp Intelligence Manager · configuração do backend
#
# Copie este ficheiro para `.env` e preencha os valores:
#     cp .env.example .env
#
# ⚠  NUNCA faça commit do ficheiro `.env`. Ele está no .gitignore.
# ⚠  NUNCA escreva estes valores dentro do código.
#
# As variáveis marcadas [FASE n] só são necessárias a partir dessa fase.
# Em desenvolvimento são opcionais; com NODE_ENV=production são obrigatórias.
##############################################################################

# ── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── Base de dados (obrigatória desde a FASE 1) ──────────────────────────────
DATABASE_URL=postgresql://wim:wim_dev_password@localhost:5432/wim
DATABASE_POOL_MAX=10
# Deixe `false`: quando o URL traz `?sslmode=require` — como acontece no Neon
# e em qualquer PostgreSQL gerido — o SSL é activado automaticamente. Esta
# variável só é precisa para servidores que exigem TLS sem o declarar no URL.
DATABASE_SSL=false

# ── Limite de pedidos ───────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m
# Limite do login, por endereço. Suba-o se toda a equipa sair pelo mesmo IP.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=1m

# ── Autenticação (OBRIGATÓRIA — sem isto o servidor não arranca) ────────────
# A forma mais simples de preencher isto é correr:  npm run setup:env
# Manualmente, gere cada um com:  openssl rand -base64 48
# Têm de ser diferentes um do outro.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── WhatsApp Cloud API [FASE 6] ─────────────────────────────────────────────
# O interruptor da integração. Com `false`, o sistema arranca sem nenhuma
# credencial da Meta e o webhook responde 503 — é assim que se põe o painel
# no ar enquanto a conta do WhatsApp Business ainda está em aprovação.
# Com `true`, as credenciais abaixo passam a ser exigidas em produção.
WHATSAPP_ENABLED=false

# Obtidos no painel Meta for Developers → a sua app → WhatsApp.
# WHATSAPP_APP_SECRET   : Definições da App → Básico → Chave Secreta da App
# WHATSAPP_VERIFY_TOKEN : inventado por si; tem de ser igual no painel da Meta
# WHATSAPP_ACCESS_TOKEN : use um token de System User (permanente),
#                         não o token temporário de 24 horas
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# ── Inteligência artificial [FASE 8] ────────────────────────────────────────
# Mesmo princípio: com `false` não há análise automática nem é preciso chave.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Só para quem usa um gateway à frente da Anthropic. Em condições normais,
# deixe em branco.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Equilíbrio entre custo e profundidade de análise: low | medium | high | xhigh | max
AI_EFFORT=medium
# Confiança mínima para uma resposta poder ser automática (0 a 1).
# É apenas o valor de arranque: a definição `ai.confidence_threshold`, na
# tabela `settings`, manda sobre esta e muda-se sem deploy.
AI_CONFIDENCE_THRESHOLD=0.9

# Quantas mensagens cada execução da fila processa, e com que tecto de tempo
# por chamada. O lote existe por causa do limite de duração das funções.
AI_BATCH_SIZE=5
AI_TIMEOUT_MS=45000
# Mensagens anteriores da conversa enviadas no contexto.
AI_HISTORY_LIMIT=10

# Segredo que autoriza quem dispara a fila (`POST /api/ai/analyze`).
# Obrigatório em produção com AI_ENABLED=true: sem ele, qualquer pessoa na
# internet poderia obrigar o sistema a gastar chamadas à Claude.
#   openssl rand -base64 48
CRON_SECRET=

# Só para servidores permanentes (Docker, VPS). Em serverless é ignorado,
# porque não há processo entre pedidos — aí a fila é empurrada por um
# agendador que chama POST /api/ai/analyze.
AI_WORKER_ENABLED=false
AI_WORKER_INTERVAL_MS=15000
