# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# WIM — backend
# Contexto de build: a pasta `wim/` (precisa de backend/ e database/).
#
# O `wim/` é um workspace npm: existe um único package-lock.json, na raiz, e
# as dependências ficam em /app/node_modules. Por isso copiamos sempre os
# dois package.json (backend e frontend) antes do `npm ci` — sem eles o npm
# recusa-se a resolver o lockfile, mesmo quando só queremos um workspace.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --workspace @wim/backend --include-workspace-root

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY backend/ ./backend/
RUN npm run build --workspace @wim/backend

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Só as dependências de produção: imagem menor, menos superfície de ataque.
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --omit=dev --workspace @wim/backend --include-workspace-root \
  && npm cache clean --force

COPY --from=build /app/backend/dist ./backend/dist
# As migrações vivem fora do backend e são precisas em runtime.
COPY database/ ./database/

# Nunca correr como root.
USER node

WORKDIR /app/backend

EXPOSE 3001

# O container é considerado saudável só quando a base de dados responde.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]
