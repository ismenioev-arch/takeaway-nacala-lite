# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# WIM — backend
# Contexto de build: a pasta `wim/` (precisa de backend/ e database/).
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS deps
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app/backend
COPY --from=deps /app/backend/node_modules ./node_modules
COPY backend/ ./
RUN npm run build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app/backend

# Só as dependências de produção: imagem menor, menos superfície de ataque.
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/backend/dist ./dist
# As migrações vivem fora do backend e são precisas em runtime.
COPY database/ /app/database/

# Nunca correr como root.
USER node

EXPOSE 3001

# O container é considerado saudável só quando a base de dados responde.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]
