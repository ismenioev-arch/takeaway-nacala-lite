##############################################################################
# WIM — configuração do docker compose
#
#   cp .env.example .env
#
# ⚠  NUNCA faça commit do ficheiro `.env`.
##############################################################################

# ── Base de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=wim
POSTGRES_DB=wim
# Obrigatória. Gere com:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Aplicação ────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# ── Autenticação [FASE 4] — openssl rand -base64 48 (têm de ser diferentes) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── WhatsApp Cloud API [FASE 6] ──────────────────────────────────────────────
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# ── Inteligência artificial [FASE 8] ─────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_EFFORT=medium
AI_CONFIDENCE_THRESHOLD=0.9
