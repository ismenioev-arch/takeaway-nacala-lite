##############################################################################
# Takeaway Nacala — configuração do frontend
#
#     cp .env.example .env
#
# Estas duas variáveis vão para dentro do pacote JavaScript que o browser
# descarrega. Não são segredos — a chave `anon` do Supabase foi feita para
# ser pública e quem protege os dados são as políticas de Row Level Security
# do lado do Supabase, não o facto de a chave estar escondida.
#
# O que NUNCA pode aparecer aqui é a `service_role`: essa ignora todas as
# políticas e nunca deve sair do servidor.
##############################################################################

VITE_SUPABASE_URL=https://o-seu-projecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
